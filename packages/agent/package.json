{
  "name": "@roop/agent",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "clean": "node -e 'require(\"node:fs\").rmSync(\"dist\", { recursive: true, force: true })'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run && vitest run --config vitest.workerd.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@effect/platform-node": "4.0.0-beta.97",
    "@effect/vitest": "4.0.0-beta.97",
    "@types/node": "^26.1.1",
    "effect": "4.0.0-beta.97",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.97"
  }
}
