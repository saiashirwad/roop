{
  "name": "roop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "build": "turbo run build",
    "test:package": "./scripts/test-packed-agent.sh",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
