    "@oxlint/plugins": "1.77.0",
    "@types/node": "^26.1.1",
    "effect": "4.0.0-beta.97",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0"
}
