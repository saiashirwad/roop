#!/usr/bin/env bash

set -euo pipefail

if command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  mise_bin="$HOME/.local/bin/mise"
else
  echo "Installing mise"
  curl --proto '=https' --tlsv1.2 -fsSL https://mise.run | sh
  mise_bin="$HOME/.local/bin/mise"
fi

profile="$HOME/.bash_profile"
profile_marker="# roop Orb setup: activate mise"
if ! grep -Fqx "$profile_marker" "$profile" 2>/dev/null; then
  cat >>"$profile" <<'EOF'

# roop Orb setup: activate mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi
EOF
fi

if [[ "$(cat /proc/sys/vm/overcommit_memory)" != "1" ]]; then
  echo "Enabling virtual-memory overcommit for Oxlint JavaScript plugins"
  sudo sysctl -w vm.overcommit_memory=1
fi

echo "Installing the pinned runtime"
"$mise_bin" trust --quiet "$PWD/.mise.toml"
time "$mise_bin" install --yes

echo "Installing locked project dependencies"
"$mise_bin" exec -- corepack enable
time "$mise_bin" exec -- corepack pnpm install --frozen-lockfile
