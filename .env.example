# Model provider key for the deepseek adapter (required for the default model).
DEEPSEEK_API_KEY=

# Opt-in live smoke tests for the local-CLI adapters. The claude and codex
# plugins talk to the `claude` / `codex` CLIs, which authenticate themselves;
# set these flags to run their live smoke tests (any non-empty value works).
CLAUDE_SMOKE=
CODEX_SMOKE=
